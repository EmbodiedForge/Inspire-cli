# Inspire CLI Secrets Configuration Template
#
# Copy this file to one of:
#   - ~/.config/inspire/secrets.toml (global)
#   - ./.inspire/secrets.toml (project-local)
#
# IMPORTANT: Never commit secrets.toml to version control!
# The actual secrets.toml files are in .gitignore.

[auth]
# Platform credentials (prefer environment variables for CI/CD)
# username = "your_username"
# password = "your_password"  # Use INSPIRE_PASSWORD env var instead

[ssh]
# Path to SSH setup script on the cluster (required for dropbear SSH)
# setup_script = "/path/to/your/setup_ssh.sh"

# Local paths to tools (machine-specific)
# rtunnel_bin = "/path/to/rtunnel"
# dropbear_deb_dir = "/path/to/dropbear/debs"
# sshd_deb_dir = "/path/to/sshd/debs"

[gitea]
# Gitea personal access token (use INSP_GITEA_TOKEN env var instead)
# token = "your_gitea_token"

[api]
# Docker registry URL (if using private registry)
# docker_registry = "your.docker.registry.com"

[job]
# Default project and workspace IDs (get these from the Inspire platform)
# project_id = "project-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# workspace_id = "ws-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Compute groups - available GPU compute groups for smart resource matching
# Each entry defines a compute group with its UUID and properties
[[compute_groups]]
# name = "H100 (CUDA 12.8)"
# id = "lcg-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# gpu_type = "H100"
# location = "CUDA 12.8"

[[compute_groups]]
# name = "H200 Room 1"
# id = "lcg-yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"
# gpu_type = "H200"
# location = "1号机房"
